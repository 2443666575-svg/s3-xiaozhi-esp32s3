#include <Arduino.h>

/* ★★★ 编译期硬保护：USB CDC On Boot 必须是 Enabled。
 *   本固件里 Serial(调试 printf) 和 g_link(UART0 → GPIO40/39 板间链路) 是两个对象。
 *   若 USB CDC On Boot = Disabled，Serial 会直接占用 UART0，与 g_link 抢同一个串口：
 *   调试输出混进链路、回执被踩断，表现为"数据有时能同步但回执收不到"。
 *   2026-10-20 实测踩到，直接让错误配置编不过，比烧完再猜靠谱。 */
#if !defined(ARDUINO_USB_CDC_ON_BOOT) || (ARDUINO_USB_CDC_ON_BOOT == 0)
#error "Tools -> USB CDC On Boot 必须设为 Enabled, 否则 Serial 会占用 UART0 和 GPIO40/39 板间链路抢同一个串口"
#endif

