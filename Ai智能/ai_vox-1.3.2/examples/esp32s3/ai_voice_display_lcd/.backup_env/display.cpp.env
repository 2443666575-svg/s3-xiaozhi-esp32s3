#include <esp_log.h>
#include <esp_timer.h>  // esp_timer_get_time() —— 屏保闲置计时用(替代 Arduino 的 millis)

#include <algorithm>
#include <cstdio>
#include <ctime>
#include <map>
#include <vector>

#include "esp_lvgl_port.h"
#include "font_awesome_symbols.h"
#include "font_emoji.h"
#include "wallpaper_data.h"
#include "display.h"

// 取当前毫秒时基(64 位微秒转毫秒)。
// ★ 用 ESP-IDF 原生的 esp_timer_get_time() 而不是 Arduino millis():
//   1) display.cpp 不依赖 Arduino 框架, 无需 #include <Arduino.h>
//   2) esp_timer_get_time() 返回 int64_t 微秒, 除以 1000 得 int64_t 毫秒,
//      不像 millis() 那样 32 位在 49.7 天回绕, 且本处只用于"差值比较", 天然安全
static inline uint32_t NowMs() {
  return static_cast<uint32_t>(esp_timer_get_time() / 1000);
}

LV_FONT_DECLARE(font_puhui_16_4);
LV_FONT_DECLARE(font_awesome_30_4);
LV_FONT_DECLARE(font_awesome_16_4);
// 屏保专用大字号(用户 2026-10-13: "日期字体太小、看不清" / 时钟改普通显示)
// 为什么另做字体而不是给 label 调字号: LVGL 的字体是预渲染位图,
//   lv_obj_set_style_text_font 只是"换一套字模", 没有"字号"这个属性,
//   想让字变大只能换一个 size 更大的字体文件。
// 为什么不直接复用 font_puhui_16_4: 它是全字库(6.19MB), 再按 26/72px
//   重做一份全字库会白白吃掉几百 KB Flash。屏保只用到十来个字,
//   所以用 lv_font_conv 只抽需要的字, 文件分别只有 50KB / 92KB / 117KB。
// 生成命令(源字体 simhei.ttf, 因为 msyh.ttc 是 TTC 集合 lv_font_conv 不支持):
//   # 日期行 + 温湿度行(26px, 含屏保用到的汉字)
//   # ★ -r 0xB0-0xB0 是度数符号 °; 写成 -r 0xB0 会被解析成 0xB0-0xFFFF 的大范围,
//   #   虽然 lv_font_conv 会自动合并成 sparse 表不影响结果, 但写法不清晰。
//   lv_font_conv --font simhei.ttf --size 26 --bpp 4 --format lvgl \
//     --no-compress --no-prefilter --lv-include lvgl.h \
//     --lv-font-name font_saver_26_4 -r 0x20-0x7F -r 0xB0-0xB0 \
//     --symbols "说句话或按键唤醒对时中周一二三四五六日温湿度" -o font_saver_26_4.c
//   # 大时钟(72px, 只要 ASCII 0-9 和冒号, 所以文件很小)
//   lv_font_conv --font simhei.ttf --size 72 --bpp 4 --format lvgl \
//     --no-compress --no-prefilter --lv-include lvgl.h \
//     --lv-font-name font_saver_clock_72_4 -r 0x30-0x3A -o font_saver_clock_72_4.c
LV_FONT_DECLARE(font_saver_clock_72_4);  // 72px: 屏保大时钟 "HH:MM"(只有 0-9 和冒号)
LV_FONT_DECLARE(font_saver_26_4);        // 26px: 日期行 + 温湿度行
// 30px 备用: 当前未使用。同一批生成的, 想给日期再放大时直接换 &font_saver_30_4
// (注意 30px 下日期行宽会涨到约 202px, 面板内可用宽 212px, 只剩 10px 余量)。
LV_FONT_DECLARE(font_saver_30_4);

// ---------------- 屏保参数 ----------------
// "尚未记录活动/尚未刷新"的哨兵值。不用 0 是因为 esp_timer_get_time() 在开机极早期
// 可能返回 <1000us, 使 NowMs() 恰好为 0, 与"未初始化"混淆。
static constexpr uint32_t kNoActivitySentinel = 0xFFFFFFFFu;
// 闲置多久进入屏保(ms)。30 秒: 说完话 30 秒没人理就息屏(用户 2026-10-13 指定)
static constexpr uint32_t kScreenSaverIdleMs = 30 * 1000;
// 屏保时钟刷新间隔(ms)。1000ms 正好每秒跳一下
static constexpr uint32_t kScreenSaverClockIntervalMs = 1000;

// 屏保时钟面板的纵向位置: 面板顶边距屏幕顶部的百分比。
// 照片是人物合影、脸在上半部, 取 45% 让面板落在下半屏, 避开人脸。
// ★ 面板高度(2026-10-14 加了温湿度行后) =
//     14(pad_top) + 52(时钟 line_height) + 10(pad_row) + 27(日期) + 10(pad_row)
//     + 27(温湿度) + 14(pad_bottom) = 154px
//   (加温湿度行之前是 117px, 现在 +27+10 = 154px)
//   顶边百分比上限 = (320-154)/320 = 51.9%; 为底部至少留 10px 余量, 建议 top 不超过 48.8%。
//   参考(154px 高): 40%=顶边128底边282余38 / 45%=144/298/22 / 48%=153/307/13 / 50%=160/314/6(太紧)
// ★★ 改这个值【只会移动时钟面板】, 照片不会被带走 —— 屏保容器不是 flex,
//    wallpaper 用 set_pos(0,0) 钉死, saver_panel 用 align 独立定位, 两者互不影响。
//    这是之前"移动时钟结果照片一起下移"那个 bug 的修复成果, 别再改回去用 pad_top。
static constexpr int kSaverPanelTopPct = 45;

// ---------------- 屏保大时钟 ----------------
// ★ 2026-10-13 改动: 原来是 28 个小矩形拼的"7 段数码管"(带鬼影效果),
//   用户要求"数码显示效果去除, 换成普通显示" → 改成普通文本时钟。
//   一块 lv_label 显示 "HH:MM", 用 72px 字体(&font_saver_clock_72_4, 见顶部声明)。
//   好处: 少 30 个 lv_obj(28 段 + 2 个冒号点), 省 RAM 也省每次刷新的 28 次属性写。
//   "00:00" 实测宽 180px, 面板内可用宽 212px, 余量 32px。

// ---------------- 屏保照片背景 ----------------
// kWallpaperMap / kWallpaperDsc 都定义在 wallpaper_data.c (C 编译)。
// ★ 为什么描述符不放在这里: lv_image_dsc_t 的"嵌套指定初始化器"
//   (.header.magic = ... 这种写法) 是 C 语法, C++ 编译器会报
//   "expected primary-expression before '.' token"。
//   放在 .c 里定义、这里 extern 引用即可(声明已含在 wallpaper_data.h 中)。

// Color definitions for light theme
// 对话框背景统一为白色: 页面底色 / 状态栏 / 聊天区 / AI 气泡 全部白底
#define LIGHT_BACKGROUND_COLOR lv_color_white()            // White background (页面底色 + 状态栏)
#define LIGHT_TEXT_COLOR lv_color_black()                  // Black text (普通文字: 状态栏/用户消息)
#define LIGHT_CHAT_BACKGROUND_COLOR lv_color_white()       // White: 聊天区背景(原来是浅灰 0xE0E0E0, 按需求改白)
#define LIGHT_USER_BUBBLE_COLOR lv_color_hex(0x95EC69)     // WeChat green (用户气泡保持微信绿, 便于区分)
#define LIGHT_ASSISTANT_BUBBLE_COLOR lv_color_white()      // White: AI 气泡白底
#define LIGHT_ASSISTANT_TEXT_COLOR lv_color_hex(0x000000)  // Black: AI 回复文字(白底黑字, 用户要求改成黑色)
#define LIGHT_SYSTEM_BUBBLE_COLOR lv_color_hex(0xF5F5F5)   // Near-white: 系统提示气泡(比纯白略灰, 靠边线区分)
#define LIGHT_SYSTEM_TEXT_COLOR lv_color_hex(0x666666)     // Dark gray text (系统提示文字)
#define LIGHT_BORDER_COLOR lv_color_hex(0xD0D0D0)          // Border: 浅灰描边(比 0xE0E0E0 略深, 白底上才看得见)
#define LIGHT_LOW_BATTERY_COLOR lv_color_black()           // Black for light mode

Display::Display(esp_lcd_panel_io_handle_t panel_io,
                 esp_lcd_panel_handle_t panel,
                 int width,
                 int height,
                 int offset_x,
                 int offset_y,
                 bool mirror_x,
                 bool mirror_y,
                 bool swap_xy,
                 Kind kind)
    : width_(width),
      height_(height),
      kind_(kind),
      current_theme_{
          .background = LIGHT_BACKGROUND_COLOR,
          .text = LIGHT_TEXT_COLOR,
          .chat_background = LIGHT_CHAT_BACKGROUND_COLOR,
          .user_bubble = LIGHT_USER_BUBBLE_COLOR,
          .assistant_bubble = LIGHT_ASSISTANT_BUBBLE_COLOR,
          .assistant_text = LIGHT_ASSISTANT_TEXT_COLOR,
          .system_bubble = LIGHT_SYSTEM_BUBBLE_COLOR,
          .system_text = LIGHT_SYSTEM_TEXT_COLOR,
          .border = LIGHT_BORDER_COLOR,
          .low_battery = LIGHT_LOW_BATTERY_COLOR,
      } {
  // lvgl 全局初始化只需做一次 (lv_init + lvgl_port_init)
  // 用 static bool 标记, 第二个 Display 实例构造时直接跳过
  // task_priority 由原来的 tskIDLE_PRIORITY(0) 提到 4, 避免动画被音频任务饿死
  static bool s_lvgl_inited = false;
  if (!s_lvgl_inited) {
    s_lvgl_inited = true;
    lv_init();
    lvgl_port_cfg_t port_cfg = ESP_LVGL_PORT_INIT_CONFIG();
    port_cfg.task_priority = 4;
    port_cfg.task_stack = 8192;
    port_cfg.timer_period_ms = 50;
    lvgl_port_init(&port_cfg);
  }

  // 把这块屏刷成白底 (每个 display 自己刷一次)
  std::vector<uint16_t> buffer(width_, 0xFFFF);
  for (int y = 0; y < height_; y++) {
    esp_lcd_panel_draw_bitmap(panel, 0, y, width_, y + 1, buffer.data());
  }

  ESP_ERROR_CHECK(esp_lcd_panel_disp_on_off(panel, true));

  // 把 panel_io 注册到 lvgl, 创建 lv_display_t
  // ★ 缓冲区大小直接决定刷新观感:
  //   原 width*10 (=2400px, 约15行) 时, 一帧 320 行要分 21 次推送, 逐块自上而下刷 ->
  //   表现为"像翻页一样"的横向撕裂/滚动。
  //   用 width*40 (=9600px, 约40行) + 双缓冲: 一帧分 8 次推完、两块交替,
  //   观感明显改善, 内存只吃 9600*2*2 = 38.4KB (内部 RAM)。
  //   ⚠️ 不要盲目加大: 半屏(75KB)x2=150KB 会挤占 ai_vox 引擎/WiFi/TLS 所需的内部 RAM,
  //      实测会导致 "加载协议失败" (网络握手内存不足)。屏刷得好看, 但引擎跑不起来。
  //   注意 ESP32-S3 的 SOC_PSRAM_DMA_CAPABLE==0, buff_dma 与 buff_spiram 不能同时置 1。
  const uint32_t kBufPixels = static_cast<uint32_t>(width) * 40;
  const lvgl_port_display_cfg_t display_cfg = {
      .io_handle = panel_io,
      .panel_handle = panel,
      .control_handle = nullptr,
      .buffer_size = kBufPixels,  // ★ 约 40 行/块, 兼顾流畅与内存
      .double_buffer = true,      // ★ 双缓冲: 消除撕裂
      .trans_size = 0,
      .hres = static_cast<uint32_t>(width),
      .vres = static_cast<uint32_t>(height),
      .monochrome = false,
      .rotation =
          {
              .swap_xy = swap_xy,
              .mirror_x = mirror_x,
              .mirror_y = mirror_y,
          },
      .color_format = LV_COLOR_FORMAT_RGB565,
      .flags =
          {
              .buff_dma = 1,     // 内部 RAM + DMA, 推屏最快
              .buff_spiram = 0,  // S3 上不能与 buff_dma 同时为 1
              .sw_rotate = 0,
              .swap_bytes = 1,
              .full_refresh = 0,
              .direct_mode = 0,
          },
  };

  display_ = lvgl_port_add_disp(&display_cfg);

  assert(display_ != nullptr);
  if (display_ == nullptr) {
    abort();
    return;
  }

  if (offset_x != 0 || offset_y != 0) {
    lv_display_set_offset(display_, offset_x, offset_y);
  }
}

Display::~Display() {
  // TODO:
}

void Display::Start() {
  if (kind_ == Kind::kChat) {
    StartChatUi();
  } else {
    StartSensorUi();
  }
}

void Display::StartChatUi() {
  lvgl_port_lock(0);

  // 多 display 场景下必须用 lv_display_get_screen_active 拿当前 display 的 screen,
  // 不能用全局 lv_screen_active() (会拿到 default display 的 screen)
  auto screen = lv_display_get_screen_active(display_);
  lv_obj_set_style_text_font(screen, &font_puhui_16_4, 0);
  lv_obj_set_style_text_color(screen, current_theme_.text, 0);
  lv_obj_set_style_bg_color(screen, current_theme_.background, 0);
  // ★ 必须同时设 bg_opa: LVGL 只设 bg_color 不设 bg_opa 时背景是"透明"(LV_OPA_TRANSP),
  //   透明区会透到面板默认色 -> 显示成黑底。这是"背景改白不生效"的真正原因。
  lv_obj_set_style_bg_opa(screen, LV_OPA_COVER, 0);

  /* Container */
  container_ = lv_obj_create(screen);
  lv_obj_set_size(container_, LV_HOR_RES, LV_VER_RES);
  lv_obj_set_flex_flow(container_, LV_FLEX_FLOW_COLUMN);
  lv_obj_set_style_pad_all(container_, 0, 0);
  lv_obj_set_style_border_width(container_, 0, 0);
  lv_obj_set_style_pad_row(container_, 0, 0);
  lv_obj_set_style_bg_color(container_, current_theme_.background, 0);
  lv_obj_set_style_bg_opa(container_, LV_OPA_COVER, 0);  // ★ 白底必须不透明
  lv_obj_set_style_border_color(container_, current_theme_.border, 0);

  /* Status bar */
  status_bar_ = lv_obj_create(container_);
  lv_obj_set_size(status_bar_, LV_HOR_RES, LV_SIZE_CONTENT);
  lv_obj_set_style_radius(status_bar_, 0, 0);
  lv_obj_set_style_bg_color(status_bar_, current_theme_.background, 0);
  lv_obj_set_style_bg_opa(status_bar_, LV_OPA_COVER, 0);  // ★
  lv_obj_set_style_text_color(status_bar_, current_theme_.text, 0);
  // 全白背景下状态栏与聊天区同色, 用 1px 底边线把两者分开
  lv_obj_set_style_border_side(status_bar_, LV_BORDER_SIDE_BOTTOM, 0);
  lv_obj_set_style_border_width(status_bar_, 1, 0);
  lv_obj_set_style_border_color(status_bar_, current_theme_.border, 0);
  lv_obj_set_style_pad_bottom(status_bar_, 3, 0);

  /* Content - Chat area */
  content_ = lv_obj_create(container_);
  lv_obj_set_style_radius(content_, 0, 0);
  lv_obj_set_width(content_, LV_HOR_RES);
  lv_obj_set_flex_grow(content_, 1);
  lv_obj_set_style_pad_all(content_, 10, 0);
  lv_obj_set_style_bg_color(content_, current_theme_.chat_background, 0);  // Background for chat area
  lv_obj_set_style_bg_opa(content_, LV_OPA_COVER, 0);                      // ★ 聊天区白底必须不透明
  lv_obj_set_style_border_color(content_, current_theme_.border, 0);       // Border color for chat area
  lv_obj_set_style_border_width(content_, 0, 0);                           // 聊天区不需要外框, 避免白底上多一层灰线

  // Enable scrolling for chat content
  lv_obj_set_scrollbar_mode(content_, LV_SCROLLBAR_MODE_OFF);
  lv_obj_set_scroll_dir(content_, LV_DIR_VER);

  // Create a flex container for chat messages
  lv_obj_set_flex_flow(content_, LV_FLEX_FLOW_COLUMN);
  lv_obj_set_flex_align(content_, LV_FLEX_ALIGN_START, LV_FLEX_ALIGN_START, LV_FLEX_ALIGN_START);
  lv_obj_set_style_pad_row(content_, 10, 0);  // Space between messages

  // We'll create chat messages dynamically in SetChatMessage
  chat_message_label_ = nullptr;

  /* Status bar */
  lv_obj_set_flex_flow(status_bar_, LV_FLEX_FLOW_ROW);
  lv_obj_set_style_pad_all(status_bar_, 0, 0);
  lv_obj_set_style_border_width(status_bar_, 0, 0);
  lv_obj_set_style_pad_column(status_bar_, 0, 0);
  lv_obj_set_style_pad_left(status_bar_, 10, 0);
  lv_obj_set_style_pad_right(status_bar_, 10, 0);
  lv_obj_set_style_pad_top(status_bar_, 2, 0);
  lv_obj_set_style_pad_bottom(status_bar_, 2, 0);
  lv_obj_set_scrollbar_mode(status_bar_, LV_SCROLLBAR_MODE_OFF);
  lv_obj_set_flex_align(status_bar_, LV_FLEX_ALIGN_SPACE_BETWEEN, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);

  emotion_label_ = lv_label_create(status_bar_);
  lv_obj_set_style_text_font(emotion_label_, &font_awesome_30_4, 0);
  lv_obj_set_style_text_color(emotion_label_, current_theme_.text, 0);
  lv_label_set_text(emotion_label_, FONT_AWESOME_AI_CHIP);
  lv_obj_set_style_margin_right(emotion_label_, 5, 0);

  notification_label_ = lv_label_create(status_bar_);
  lv_obj_set_flex_grow(notification_label_, 1);
  lv_obj_set_style_text_align(notification_label_, LV_TEXT_ALIGN_CENTER, 0);
  lv_obj_set_style_text_color(notification_label_, current_theme_.text, 0);
  lv_label_set_text(notification_label_, "");
  lv_obj_add_flag(notification_label_, LV_OBJ_FLAG_HIDDEN);

  status_label_ = lv_label_create(status_bar_);
  lv_obj_set_flex_grow(status_label_, 1);
  lv_label_set_long_mode(status_label_, LV_LABEL_LONG_SCROLL_CIRCULAR);
  lv_obj_set_style_text_align(status_label_, LV_TEXT_ALIGN_CENTER, 0);
  lv_obj_set_style_text_color(status_label_, current_theme_.text, 0);
  lv_label_set_text(status_label_, "初始化");

  mute_label_ = lv_label_create(status_bar_);
  lv_label_set_text(mute_label_, "");
  lv_obj_set_style_text_font(mute_label_, &font_awesome_16_4, 0);
  lv_obj_set_style_text_color(mute_label_, current_theme_.text, 0);

  network_label_ = lv_label_create(status_bar_);
  lv_label_set_text(network_label_, "");
  lv_obj_set_style_text_font(network_label_, &font_awesome_16_4, 0);
  lv_obj_set_style_text_color(network_label_, current_theme_.text, 0);
  lv_obj_set_style_margin_left(network_label_, 5, 0);

  /* ---------- 屏保层 (全屏覆盖, 默认隐藏, 照片背景) ---------- */
  // 关键点: 直接挂在 screen 上(而不是 container_ 里), 这样它可以盖住状态栏和聊天区,
  //         且不受 container_ 的 COLUMN flex 布局影响; 后创建 => z-order 在上层。
  // 尺寸用 width_/height_ 而不是 LV_HOR_RES/LV_VER_RES: 多 display 场景下后者可能
  // 取到 default display 的尺寸(本项目 main.cpp 就是两块屏), 与本屏不一定一致。
  screen_saver_ = lv_obj_create(screen);
  lv_obj_set_size(screen_saver_, width_, height_);
  lv_obj_set_pos(screen_saver_, 0, 0);
  lv_obj_set_style_radius(screen_saver_, 0, 0);
  lv_obj_set_style_pad_all(screen_saver_, 0, 0);
  lv_obj_set_style_border_width(screen_saver_, 0, 0);
  // ★ 照片背景: 容器本身透明, 照片作为第一个子对象铺满, 文字浮在照片上
  lv_obj_set_style_bg_opa(screen_saver_, LV_OPA_TRANSP, 0);
  // ★★ 屏保容器【不使用 flex 布局】, 所有子对象用绝对定位(lv_obj_align / set_pos)。
  //   原因: flex 容器里的子对象位置由布局引擎接管, lv_obj_center/set_pos 会被覆盖,
  //   导致"只想让时钟下移"却把铺满全屏的照片也一起推下去了(照片在 flex 流里一样被排)。
  //   改成绝对定位后, 照片和面板互不影响, 想动谁就只动谁。
  lv_obj_clear_flag(screen_saver_, LV_OBJ_FLAG_SCROLLABLE);
  // 阻止点击穿透(屏保是"最上层遮挡", 不允许用户点到下面的聊天内容)
  lv_obj_add_flag(screen_saver_, LV_OBJ_FLAG_CLICKABLE);
  lv_obj_add_flag(screen_saver_, LV_OBJ_FLAG_HIDDEN);  // 默认隐藏, 闲置后才显示

  // 照片铺满整个屏保层, 绝对定位钉在左上角(0,0), 不受任何布局影响
  lv_obj_t* wallpaper = lv_image_create(screen_saver_);
  lv_image_set_src(wallpaper, &kWallpaperDsc);
  lv_obj_set_size(wallpaper, width_, height_);
  lv_obj_set_pos(wallpaper, 0, 0);  // 钉在 (0,0), 铺满全屏

  // ★ 照片上直接放黑字可能看不清(照片有深色区域), 所以把时钟/日期包进一个
  //   半透明白色圆角底板里, 用深色文字, 任何照片下都保证可读。
  //   配色说明: 照片整体偏亮, 原来是"半透明黑底 + 白字";
  //             现按需求改为"半透明白底 + 黑字"(深色系照片上白底反而更醒目)。
  lv_obj_t* saver_panel = lv_obj_create(screen_saver_);
  lv_obj_set_size(saver_panel, LV_SIZE_CONTENT, LV_SIZE_CONTENT);
  lv_obj_set_style_bg_color(saver_panel, lv_color_white(), 0);
  lv_obj_set_style_bg_opa(saver_panel, LV_OPA_70, 0);   // 70% 白: 够亮以衬托黑字, 又略微透出照片
  lv_obj_set_style_radius(saver_panel, 14, 0);
  lv_obj_set_style_border_width(saver_panel, 0, 0);
  lv_obj_set_style_pad_all(saver_panel, 14, 0);
  lv_obj_set_style_pad_row(saver_panel, 10, 0);
  lv_obj_set_flex_flow(saver_panel, LV_FLEX_FLOW_COLUMN);   // 面板内部仍是 flex(竖排: 时钟 + 日期)
  lv_obj_set_flex_align(saver_panel, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);
  lv_obj_clear_flag(saver_panel, LV_OBJ_FLAG_SCROLLABLE);
  // 文字默认色: 面板内所有文字用黑色(label 内部也可各自覆盖)
  lv_obj_set_style_text_color(saver_panel, lv_color_black(), 0);
  // ★ 面板用绝对定位落在屏幕下方(避开照片里的人脸)。
  //   横向居中, 纵向: 顶部偏移屏高的 kSaverPanelTopPct%, 面板高度自适应。
  //   因为外层已不是 flex, 这里的 align 不会再被覆盖, 照片也不会被一起推走。
  lv_obj_align(saver_panel, LV_ALIGN_TOP_MID, 0, (int)(height_ * kSaverPanelTopPct / 100));

  /* 大时钟: 普通文本 "HH:MM" (2026-10-13 由 7 段数码管改为普通显示) */
  // ★ 原来这里用 4 个数位容器 × 7 个小矩形(共 28 段) + 2 个冒号点拼"数码管"效果,
  //   带有"灭段 20% 亮度"的鬼影。用户要求去掉数码管效果 → 改成一块普通 label。
  //   顺带收益: 少了 30 个 lv_obj, 每次刷新也从"写 30 次 bg_opa"变成"改 1 次文本"。
  saver_clock_label_ = lv_label_create(saver_panel);
  lv_obj_set_style_text_font(saver_clock_label_, &font_saver_clock_72_4, 0);
  lv_obj_set_style_text_color(saver_clock_label_, lv_color_black(), 0);
  // 时间未对时成功(或初值)时, 显示占位符, 避免出现 "00:00" 误导
  lv_label_set_text(saver_clock_label_, "--:--");

  // 日期 (白底板内, 黑字)。
  // ★ 字号 16 → 26: 用户反馈"日期字体太小看不清"。字体是预渲染位图,
  //   变大只能换更大 size 的字体文件(见文件顶部的 LV_FONT_DECLARE 注释)。
  saver_date_label_ = lv_label_create(saver_panel);
  lv_obj_set_style_text_font(saver_date_label_, &font_saver_26_4, 0);
  lv_obj_set_style_text_color(saver_date_label_, lv_color_black(), 0);
  lv_label_set_text(saver_date_label_, "----/--/--");

  // 温湿度行 (2026-10-14 新增, 用户要求"在时间下方显示现在的温湿度")。
  // ★ 放在日期行之后: 面板内部是 flex 竖排(COLUMN), 新 label 自动排到日期下方,
  //   不需要改任何坐标, 也不会影响时钟/日期/照片的位置。
  // ★ 文案 "温 32C 湿 33%" 宽 169px, 面板内可用宽 212px, 余 43px。
  //   温度湿度都取整, 是量过宽度的结果:
  //     "温 32.3C 湿 32.6%" = 221px  → 溢出 9px ✗
  //     "温 32C 湿 33%"      = 169px  → 安全    ✓ (最坏值 99C/100% 也只有 182px)
  //   另外不用 "°C": SimHei 里 ° 是全角 26px, "25.3°C" 会到 221px 直接溢出;
  //   用 C 表示摄氏度, 语义清楚又省一半宽度。
  saver_env_label_ = lv_label_create(saver_panel);
  lv_obj_set_style_text_font(saver_env_label_, &font_saver_26_4, 0);
  lv_obj_set_style_text_color(saver_env_label_, lv_color_black(), 0);
  // 初值: 传感器还没读数时显示占位符, 不要显示 0C 那是误导
  lv_label_set_text(saver_env_label_, "温 -- 湿 --");

  // ★ 底部提示行("说句话或按 BOOT")已按用户要求【整行删除】(2026-10-13)。
  //   相关成员 saver_hint_label_ 也已从 display.h 移除, 面板内只剩 时钟 + 日期 + 温湿度 三行。

  lvgl_port_unlock();
}

void Display::StartSensorUi() {
  lvgl_port_lock(0);

  auto screen = lv_display_get_screen_active(display_);
  lv_obj_set_style_bg_color(screen, current_theme_.background, 0);
  lv_obj_set_style_bg_opa(screen, LV_OPA_COVER, 0);  // ★ 同 StartChatUi: 不设 opa 会透成黑底
  lv_obj_set_style_text_font(screen, &font_puhui_16_4, 0);
  lv_obj_set_style_text_color(screen, current_theme_.text, 0);

  // 标题
  sensor_title_label_ = lv_label_create(screen);
  lv_label_set_text(sensor_title_label_, "传感器数据");
  lv_obj_align(sensor_title_label_, LV_ALIGN_TOP_MID, 0, 30);
  lv_obj_set_style_text_font(sensor_title_label_, &font_puhui_16_4, 0);

  // 温度
  sensor_temp_label_ = lv_label_create(screen);
  lv_label_set_text(sensor_temp_label_, "温度: --");
  lv_obj_align(sensor_temp_label_, LV_ALIGN_CENTER, 0, -30);
  lv_obj_set_style_text_font(sensor_temp_label_, &font_puhui_16_4, 0);

  // 湿度
  sensor_hum_label_ = lv_label_create(screen);
  lv_label_set_text(sensor_hum_label_, "湿度: --");
  lv_obj_align(sensor_hum_label_, LV_ALIGN_CENTER, 0, 10);
  lv_obj_set_style_text_font(sensor_hum_label_, &font_puhui_16_4, 0);

  // 错误/状态信息
  sensor_msg_label_ = lv_label_create(screen);
  lv_label_set_text(sensor_msg_label_, "");
  lv_obj_align(sensor_msg_label_, LV_ALIGN_BOTTOM_MID, 0, -25);
  lv_obj_set_style_text_color(sensor_msg_label_, lv_color_hex(0x888888), 0);
  lv_obj_set_width(sensor_msg_label_, LV_HOR_RES - 20);
  lv_obj_set_style_text_align(sensor_msg_label_, LV_TEXT_ALIGN_CENTER, 0);

  lvgl_port_unlock();
}

void Display::SetSensorData(float temperature, float humidity, bool valid, const char* msg) {
  if (kind_ != Kind::kSensor || display_ == nullptr) {
    return;
  }
  lvgl_port_lock(0);
  if (valid) {
    char buf_temp[32];
    snprintf(buf_temp, sizeof(buf_temp), "温度: %.1f °C", temperature);
    lv_label_set_text(sensor_temp_label_, buf_temp);

    char buf_hum[32];
    snprintf(buf_hum, sizeof(buf_hum), "湿度: %.0f %%", humidity);
    lv_label_set_text(sensor_hum_label_, buf_hum);

    if (sensor_msg_label_ != nullptr) {
      lv_label_set_text(sensor_msg_label_, "");
    }
  } else {
    lv_label_set_text(sensor_temp_label_, "温度: --");
    lv_label_set_text(sensor_hum_label_, "湿度: --");
    if (sensor_msg_label_ != nullptr) {
      lv_label_set_text(sensor_msg_label_, msg != nullptr ? msg : "传感器无响应");
    }
  }
  lvgl_port_unlock();
}

// 屏保温湿度行: 由主循环在 SensorPoll() 之后调用(每 3 秒一次)。
// ★ 只在数据真正变化时才写 label: 每 3 秒无条件写一次文本会让 LVGL 每次都重绘,
//   白白吃 CPU(屏保本意是省电/省寿命)。
// ★ 这里不调用 WakeUp(): 传感器数据更新属于"后台刷新", 不应把用户从屏保里踢出来。
void Display::SetEnvForScreenSaver(float temperature, float humidity, bool valid) {
  if (kind_ != Kind::kChat || display_ == nullptr || saver_env_label_ == nullptr) {
    return;  // 只有主屏屏保有这一行
  }

  // 变化判定阈值: 温度 0.5°C, 湿度 0.5%。
  // ★ 阈值必须 >= 显示精度, 否则会出现"数值在临界点反复跳 -> 每 3 秒都重绘"。
  //   显示是整数(%.0f), 所以取 0.5 —— 只有跨过整数台阶才刷, 稳态下几乎不刷。
  const bool changed = !saver_env_has_value_ || (valid != saver_env_valid_) ||
                       (valid && (temperature > saver_env_temp_ + 0.5f || temperature < saver_env_temp_ - 0.5f ||
                                  humidity > saver_env_hum_ + 0.5f || humidity < saver_env_hum_ - 0.5f));
  if (!changed) {
    return;
  }

  saver_env_temp_ = temperature;
  saver_env_hum_ = humidity;
  saver_env_valid_ = valid;
  saver_env_has_value_ = true;

  char buf[32] = {0};
  if (valid) {
    // 文案 "温 32C 湿 33%" —— 温度湿度都取整。
    // ★ 为什么温度不显示小数: 实测 "温 32.3C 湿 32.6%" 宽 221px, 超过面板内可用宽
    //   212px 直接溢出; 取整后 169px, 即使最坏值 "温 99C 湿 100%" 也只有 182px,
    //   留 30px 余量。且屏保是"扫一眼"的场景, 整数比小数更好读, 温湿度是慢变量
    //   整数精度足够。这里用 %.0f 且四舍五入(snprintf 的 %.0f 默认四舍五入)。
    snprintf(buf, sizeof(buf), "温 %.0fC 湿 %.0f%%", temperature, humidity);
  } else {
    snprintf(buf, sizeof(buf), "温 -- 湿 --");
  }

  lvgl_port_lock(0);
  lv_label_set_text(saver_env_label_, buf);
  lvgl_port_unlock();
}

#define MAX_MESSAGES (5)
void Display::SetChatMessage(const Role role, const std::string& content) {
  if (content.empty()) {
    return;
  }
  WakeUp();  // 有新消息 = 有活动, 退出屏保并重置闲置计时

  lvgl_port_lock(0);

  // 检查消息数量是否超过限制
  uint32_t child_count = lv_obj_get_child_cnt(content_);
  if (child_count >= MAX_MESSAGES) {
    // 删除最早的消息（第一个子对象）
    lv_obj_t* first_child = lv_obj_get_child(content_, 0);
    lv_obj_t* last_child = lv_obj_get_child(content_, child_count - 1);
    if (first_child != nullptr) {
      lv_obj_del(first_child);
    }
    // Scroll to the last message immediately
    if (last_child != nullptr) {
      lv_obj_scroll_to_view_recursive(last_child, LV_ANIM_OFF);
    }
  }

  // Create a message bubble
  lv_obj_t* msg_bubble = lv_obj_create(content_);
  lv_obj_set_style_radius(msg_bubble, 8, 0);
  lv_obj_set_scrollbar_mode(msg_bubble, LV_SCROLLBAR_MODE_OFF);
  lv_obj_set_style_border_width(msg_bubble, 1, 0);
  lv_obj_set_style_border_color(msg_bubble, current_theme_.border, 0);
  lv_obj_set_style_bg_opa(msg_bubble, LV_OPA_COVER, 0);  // ★ 气泡背景必须不透明, 否则透出黑底
  lv_obj_set_style_pad_all(msg_bubble, 8, 0);

  // Create the message text
  lv_obj_t* msg_text = lv_label_create(msg_bubble);
  lv_label_set_text(msg_text, content.c_str());

  // 计算文本实际宽度
  lv_coord_t text_width = lv_txt_get_width(content.c_str(), content.size(), &font_puhui_16_4, 0);

  // 计算气泡宽度
  lv_coord_t max_width = LV_HOR_RES * 85 / 100 - 16;  // 屏幕宽度的85%
  lv_coord_t min_width = 20;
  lv_coord_t bubble_width;

  // 确保文本宽度不小于最小宽度
  if (text_width < min_width) {
    text_width = min_width;
  }

  // 如果文本宽度小于最大宽度，使用文本宽度
  if (text_width < max_width) {
    bubble_width = text_width;
  } else {
    bubble_width = max_width;
  }

  // 设置消息文本的宽度
  lv_obj_set_width(msg_text, bubble_width);  // 减去padding
  lv_label_set_long_mode(msg_text, LV_LABEL_LONG_WRAP);
  lv_obj_set_style_text_font(msg_text, &font_puhui_16_4, 0);

  // 设置气泡宽度
  lv_obj_set_width(msg_bubble, bubble_width);
  lv_obj_set_height(msg_bubble, LV_SIZE_CONTENT);

  // Set alignment and style based on message role
  if (role == Role::kUser) {
    lv_obj_set_style_bg_color(msg_bubble, current_theme_.user_bubble, 0);
    lv_obj_set_style_text_color(msg_text, current_theme_.text, 0);
    lv_obj_set_user_data(msg_bubble, (void*)"user");
    lv_obj_set_width(msg_bubble, LV_SIZE_CONTENT);
    lv_obj_set_height(msg_bubble, LV_SIZE_CONTENT);
    lv_obj_set_style_flex_grow(msg_bubble, 0, 0);
  } else if (role == Role::kAssistant) {
    lv_obj_set_style_bg_color(msg_bubble, current_theme_.assistant_bubble, 0);
    // AI 回复文字用蓝色(白底气泡上对比清晰)
    lv_obj_set_style_text_color(msg_text, current_theme_.assistant_text, 0);
    lv_obj_set_user_data(msg_bubble, (void*)"assistant");
    lv_obj_set_width(msg_bubble, LV_SIZE_CONTENT);
    lv_obj_set_height(msg_bubble, LV_SIZE_CONTENT);
    lv_obj_set_style_flex_grow(msg_bubble, 0, 0);
  } else if (role == Role::kSystem) {
    lv_obj_set_style_bg_color(msg_bubble, current_theme_.system_bubble, 0);
    lv_obj_set_style_text_color(msg_text, current_theme_.system_text, 0);
    lv_obj_set_user_data(msg_bubble, (void*)"system");
    lv_obj_set_width(msg_bubble, LV_SIZE_CONTENT);
    lv_obj_set_height(msg_bubble, LV_SIZE_CONTENT);
    lv_obj_set_style_flex_grow(msg_bubble, 0, 0);
  }

  // Create a full-width container for user messages to ensure right alignment
  if (role == Role::kUser) {
    lv_obj_t* container = lv_obj_create(content_);
    lv_obj_set_width(container, LV_HOR_RES);
    lv_obj_set_height(container, LV_SIZE_CONTENT);
    lv_obj_set_style_bg_opa(container, LV_OPA_TRANSP, 0);
    lv_obj_set_style_border_width(container, 0, 0);
    lv_obj_set_style_pad_all(container, 0, 0);
    lv_obj_set_parent(msg_bubble, container);
    lv_obj_align(msg_bubble, LV_ALIGN_RIGHT_MID, -25, 0);
    lv_obj_scroll_to_view_recursive(container, LV_ANIM_ON);
  } else if (role == Role::kSystem) {
    lv_obj_t* container = lv_obj_create(content_);
    lv_obj_set_width(container, LV_HOR_RES);
    lv_obj_set_height(container, LV_SIZE_CONTENT);
    lv_obj_set_style_bg_opa(container, LV_OPA_TRANSP, 0);
    lv_obj_set_style_border_width(container, 0, 0);
    lv_obj_set_style_pad_all(container, 0, 0);
    lv_obj_set_parent(msg_bubble, container);
    lv_obj_align(msg_bubble, LV_ALIGN_CENTER, 0, 0);
    lv_obj_scroll_to_view_recursive(container, LV_ANIM_ON);
  } else {
    lv_obj_align(msg_bubble, LV_ALIGN_LEFT_MID, 0, 0);
    lv_obj_scroll_to_view_recursive(msg_bubble, LV_ANIM_ON);
  }

  chat_message_label_ = msg_text;
  lvgl_port_unlock();
}

void Display::ShowStatus(const char* status) {
  if (kind_ != Kind::kChat || status_label_ == nullptr) {
    return;
  }
  WakeUp();  // 状态变化 = 有活动, 退出屏保并重置闲置计时
  lvgl_port_lock(0);
  lv_label_set_text(status_label_, status);
  lv_obj_clear_flag(status_label_, LV_OBJ_FLAG_HIDDEN);
  lv_obj_add_flag(notification_label_, LV_OBJ_FLAG_HIDDEN);
  lvgl_port_unlock();
}

void Display::SetEmotion(const std::string& emotion) {
  if (kind_ != Kind::kChat || emotion_label_ == nullptr) {
    return;
  }
  WakeUp();  // 表情变化 = 有活动
  std::map<std::string, const char*> emotion_map = {
      {"neutral", "😶"}, {"happy", "🙂"},       {"laughing", "😆"},  {"funny", "😂"},     {"sad", "😔"},      {"angry", "😠"},   {"crying", "😭"},
      {"loving", "😍"},  {"embarrassed", "😳"}, {"surprised", "😯"}, {"shocked", "😱"},   {"thinking", "🤔"}, {"winking", "😉"}, {"cool", "😎"},
      {"relaxed", "😌"}, {"delicious", "🤤"},   {"kissy", "😘"},     {"confident", "😏"}, {"sleepy", "😴"},   {"silly", "😜"},   {"confused", "🙄"},
  };

  auto it = emotion_map.find(emotion);

  lvgl_port_lock(0);
  lv_obj_set_style_text_font(emotion_label_, font_emoji_32_init(), 0);
  if (it != emotion_map.end()) {
    lv_label_set_text(emotion_label_, it->second);
  } else {
    lv_label_set_text(emotion_label_, "😶");
  }
  lvgl_port_unlock();
}

// ==================== 屏保 (时钟) ====================

// 唤醒: 若屏保正显示则隐藏, 并把闲置计时清零
// 所有"有活动"的公开方法(ShowStatus/SetChatMessage/SetEmotion)内部都会调用它,
// 这样语音一响、文字一更新, 屏保就自动退掉, 不需要在 main.cpp 里到处插唤醒代码
void Display::WakeUp() {
  last_activity_ms_ = NowMs();  // 无论是否在屏保中, 都重置闲置计时
  if (!screen_saver_active_) {
    return;
  }
  if (kind_ != Kind::kChat || screen_saver_ == nullptr) {
    screen_saver_active_ = false;
    return;
  }
  lvgl_port_lock(0);
  lv_obj_add_flag(screen_saver_, LV_OBJ_FLAG_HIDDEN);
  lvgl_port_unlock();
  screen_saver_active_ = false;
}

// 进入屏保: 显示覆盖层并立刻刷一次时钟
void Display::ScreenSaverTick() {
  if (kind_ != Kind::kChat || screen_saver_ == nullptr) {
    return;  // 只有主屏(聊天屏)有屏保
  }

  const uint32_t now = NowMs();

  if (!screen_saver_active_) {
    // ---- 判定是否该进入屏保 ----
    // 用 0xFFFFFFFF 作"尚未记录活动"的哨兵值: 不能拿 0 当哨兵,
    // 因为 esp_timer_get_time() 在开机极早期可能返回 <1000us, 使 NowMs() 恰好为 0。
    if (last_activity_ms_ == kNoActivitySentinel) {
      last_activity_ms_ = now;
      return;  // 先补一个基准, 避免一开机就进屏保
    }
    if (now - last_activity_ms_ < kScreenSaverIdleMs) {
      return;  // 还没闲够, 不动
    }

    // ---- 进入屏保 ----
    screen_saver_active_ = true;
    saver_last_clock_update_ms_ = kNoActivitySentinel;  // 强制下面立刻刷一次时钟
    lvgl_port_lock(0);
    lv_obj_clear_flag(screen_saver_, LV_OBJ_FLAG_HIDDEN);
    lvgl_port_unlock();
    printf("[Saver] screen saver ON\n");
  }

  // ---- 屏保中: 每秒刷新时钟 ----
  if (saver_last_clock_update_ms_ != kNoActivitySentinel &&
      now - saver_last_clock_update_ms_ < kScreenSaverClockIntervalMs) {
    return;
  }
  saver_last_clock_update_ms_ = now;

  // 取本地时间。NTP 未同步时 time() 返回很小的值(1970 附近), 此时显示占位符
  const std::time_t t = std::time(nullptr);
  // 2020-01-01 00:00:00 UTC = 1577836800。小于这个值说明还没完成 NTP 对时
  constexpr std::time_t kMinValidTime = 1577836800;

  // 两个字符串: 大时钟 "HH:MM" + 日期 "YYYY-MM-DD 周X"
  char clock_text[8] = {0};
  char date_text[32] = {0};

  if (t < kMinValidTime) {
    // 还没对时成功: 时钟显示占位符(不要显示 00:00, 那是误导), 日期显示提示
    snprintf(clock_text, sizeof(clock_text), "--:--");
    snprintf(date_text, sizeof(date_text), "对时中...");
  } else {
    struct tm timeinfo = {};
    localtime_r(&t, &timeinfo);  // 线程安全版本
    snprintf(clock_text, sizeof(clock_text), "%02d:%02d", timeinfo.tm_hour, timeinfo.tm_min);

    static const char* kWeekDays[] = {"周日", "周一", "周二", "周三", "周四", "周五", "周六"};
    const int wday = (timeinfo.tm_wday >= 0 && timeinfo.tm_wday < 7) ? timeinfo.tm_wday : 0;
    snprintf(date_text, sizeof(date_text), "%04d-%02d-%02d %s", timeinfo.tm_year + 1900, timeinfo.tm_mon + 1,
             timeinfo.tm_mday, kWeekDays[wday]);
  }

  lvgl_port_lock(0);
  // 普通文本时钟: 直接改 label 文本即可(不再有 28 段要逐个设 bg_opa)
  lv_label_set_text(saver_clock_label_, clock_text);
  lv_label_set_text(saver_date_label_, date_text);
  // ★ 温湿度行不在每秒刷: 传感器 3 秒才更新一次, 由 SetEnvForScreenSaver() 负责写。
  //   放这里的话会把"最近一次有效值"每秒重写一遍, 白费 CPU。
  lvgl_port_unlock();

  // 诊断日志: 每秒一行, 便于确认屏保是否在跑、NTP 是否对时成功
  // 用 printf 而不是 ESP_LOGI: 本工程日志级别可能被压到 WARN, ESP_LOGI 会被吞掉
  // 末段附带屏保温湿度行的当前值, 便于确认数据有没有喂进来
  if (saver_env_valid_) {
    printf("[Saver] idle=%us t=%ld clock='%s' date='%s' env='温 %.0fC 湿 %.0f%%'\n",
           (unsigned)((now - last_activity_ms_) / 1000), (long)t, clock_text, date_text, saver_env_temp_,
           saver_env_hum_);
  } else {
    printf("[Saver] idle=%us t=%ld clock='%s' date='%s' env='温 -- 湿 --'\n",
           (unsigned)((now - last_activity_ms_) / 1000), (long)t, clock_text, date_text);
  }
}

