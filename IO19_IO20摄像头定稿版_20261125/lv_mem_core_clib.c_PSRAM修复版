void * lv_malloc_core(size_t size)
{
    void * p = heap_caps_malloc(size, MALLOC_CAP_8BIT | MALLOC_CAP_SPIRAM);
    if (p == NULL) p = heap_caps_malloc(size, MALLOC_CAP_8BIT | MALLOC_CAP_INTERNAL);
    return p;
}

void * lv_realloc_core(void * p, size_t new_size)
{
    void * q = heap_caps_realloc(p, new_size, MALLOC_CAP_8BIT | MALLOC_CAP_SPIRAM);
    if (q == NULL) q = heap_caps_realloc(p, new_size, MALLOC_CAP_8BIT | MALLOC_CAP_INTERNAL);
    return q;
}

void lv_free_core(void * p)
{
    heap_caps_free(p);   /* 内部/PSRAM 指针都能正确释放 */
}

